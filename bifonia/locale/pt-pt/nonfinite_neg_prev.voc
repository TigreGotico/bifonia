# nonfinite_neg_prev.voc — Words before 'não' after which it negates an infinitive
# ('para não secar') or a coordinated verb ('molho e não seco'), not a verb whose
# subject is the word before it ('molho de noite não faço').
#
# Format: one term per line, lowercase; '#' starts a comment.

e
mas
nem
ou
para
que
sem
